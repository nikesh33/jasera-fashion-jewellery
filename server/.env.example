# Server Configuration
PORT=5001
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=suvarna

# JWT Authentication Secrets (Must be changed in production)
JWT_ACCESS_SECRET=replace_with_strong_random_jwt_access_secret_in_prod
JWT_REFRESH_SECRET=replace_with_strong_random_jwt_refresh_secret_in_prod
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Razorpay Payment Gateway (Get from Razorpay Dashboard)
# Set to real test/live keys for live checkout; in development sandbox mode will trigger if placeholder
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Media and Image Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
